pingme() {
  local message="$*"
  if [[ -z "$message" ]]; then
    message="Task completed!"
  fi

  if [[ -z "${TELEGRAM_BOT_TOKEN:-}" || -z "${TELEGRAM_CHAT_ID:-}" ]]; then
    echo "❌ Error: TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID must be set." >&2
    return 1
  fi

  # Build JSON payload safely with jq (prevents injection via $message).
  local json_data
  json_data=$(jq -nc \
    --arg chat_id "$TELEGRAM_CHAT_ID" \
    --arg text  "$message" \
    '{chat_id:$chat_id, text:$text, disable_notification:true}') || return 1

  # Deliver the payload from a private temp file. Embedding JSON in the
  # curl config is unsafe: curl's config parser treats \" as an escape
  # and truncates the body at the first quoted character. NB: the @file
  # value MUST stay unquoted — a quoted "@/path" sends an empty body.
  local payload_file
  payload_file=$(mktemp) || return 1
  chmod 600 "$payload_file"
  printf '%s' "$json_data" > "$payload_file"

  # Pass URL + headers via curl --config - (stdin) so the bot token never
  # appears in argv (where it would be visible via `ps`).
  # TELEGRAM_API_URL is overridable so tests can use a local endpoint.
  local api_base="${TELEGRAM_API_URL:-https://api.telegram.org}"
  local response rc=0
  response=$(curl --config - <<EOF
silent
show-error
request = POST
url = "$api_base/$TELEGRAM_BOT_TOKEN/sendMessage"
header = "Content-Type: application/json"
data = @$payload_file
EOF
  ) || rc=$?
  rm -f "$payload_file"

  if [[ $rc -ne 0 ]] || [[ "$response" != *"\"ok\":true"* ]]; then
    echo "❌ Error: Failed to send Telegram message." >&2
    echo "Response from server: $response" >&2
    return 1
  fi
}
